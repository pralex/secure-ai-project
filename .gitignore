# Секреты
.env
.env.*
!.env.example
*.key
*.pem

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.coverage

# Node
node_modules/
dist/
.npm/
.vite/

# Docker volumes (если локальные)
postgres_data/

# Данные агента (БД opencode, /connect ключи) — на хосте, но не в git.
# Отслеживаем только заглушки .gitkeep, чтобы каталоги существовали в клонах
# и Docker не создавал их root-owned (иначе агент не может писать).
agent/data/*
agent/data/**/*
!agent/data/**/.gitkeep
!agent/data/**/

# Logs
*.log
